# All values here are FIRST-RUN DEFAULTS — everything can be changed at runtime
# in the admin panel (/admin). Once settings are saved there, they are persisted
# (data/settings.json by default) and take precedence on every startup. To make
# .env authoritative again, delete that file and restart.

# Port the app (frontend + API) listens on. Editable in the admin panel too,
# but a port change only takes effect after a restart. In Docker, change it
# HERE — the compose port mapping reads it from .env.
APP_PORT=3000

# PP host: "localhost" for PP on the same machine (auto-mapped to the host in
# Docker), or a LAN IP (e.g. 192.168.1.50) for PP on another machine.
PROPRESENTER_HOST=localhost
PROPRESENTER_PORT=49160
PROPRESENTER_PROTOCOL=rest #or ws for <7.9 PP version
PROPRESENTER_PASSWORD= #Remote Apps Controller password; only used with ws protocol (REST has no auth)
ADMIN_PIN=1234
