# =============================================================================
# REQUIRED
# =============================================================================

# Port the app (frontend + API) listens on. Changing it requires a restart.
APP_PORT=3000

# =============================================================================
# FIRST-RUN DEFAULTS (optional)
# =============================================================================
# Everything below can be changed at runtime in the admin panel
# ("ProPresenter connection" section). These values only apply until settings
# are saved there for the first time — after that, data/settings.json takes
# precedence on every startup. To make .env authoritative again, delete
# data/settings.json and restart.

# PP host: "localhost" for PP on the same machine (auto-mapped to the host in
# Docker), or a LAN IP (e.g. 192.168.1.50) for PP on another machine.
PROPRESENTER_HOST=localhost
PROPRESENTER_PORT=49160
PROPRESENTER_PROTOCOL=rest #or ws for <7.9 PP version
PROPRESENTER_PASSWORD= #Remote Apps Controller password; only used with ws protocol (REST has no auth)
ADMIN_PIN=1234
